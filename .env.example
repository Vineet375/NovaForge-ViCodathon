# =============================================================================
# NovaForge AI Interview Agent – Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the required values.
# NEVER commit your .env file – it is gitignored.
# =============================================================================

# --- Google Gemini AI -----------------------------------------------------------
# Required. Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Required. The Gemini model to use.
# Recommended: gemini-2.5-flash-lite-preview-06-17
# If the configured model returns 404, update this value to a currently
# available model from https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash-lite-preview-06-17

# --- Backend -------------------------------------------------------------------
# Optional. Defaults to 8000 if not set.
PORT=8000

# Optional. Controls logging verbosity. Values: development | production
ENVIRONMENT=development

# --- Frontend ------------------------------------------------------------------
# Required for the Next.js frontend to reach the backend.
# Must match the port the backend is running on.
NEXT_PUBLIC_API_URL=http://localhost:8000
