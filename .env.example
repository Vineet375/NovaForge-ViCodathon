# =============================================================================
# NovaForge AI Interview Agent – Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the required values.
# NEVER commit your .env file – it is gitignored.
# =============================================================================

# --- Google Gemini AI -----------------------------------------------------------
# Provide up to 3 API keys for automatic failover.
GEMINI_API_KEY_1=AIzaSyA_example_key_1
GEMINI_API_KEY_2=AIzaSyA_example_key_2
GEMINI_API_KEY_3=AIzaSyA_example_key_3

# Required. The Gemini model to use.
GEMINI_MODEL=gemini-3.5-flash

# --- NVIDIA NIM AI (Fallback) ---------------------------------------------------
# Provide API key to enable Llama-3 based fallback.
NVIDIA_API_KEY_1=
NVIDIA_MODEL_PRIMARY=meta/llama-3.3-70b-instruct
NVIDIA_API_KEY_2=
NVIDIA_MODEL_SECONDARY=meta/llama-3.1-70b-instruct

# --- Backend -------------------------------------------------------------------
# Optional. Defaults to 8000 if not set.
PORT=8000

# Optional. Controls logging verbosity. Values: development | production
ENVIRONMENT=development

# --- Frontend ------------------------------------------------------------------
# Required for the Next.js frontend to reach the backend.
# Must match the port the backend is running on.
NEXT_PUBLIC_API_URL=http://localhost:8000
